<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:name=".FadocxApplication"
        android:label="${appName}"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            
            <!-- File type handlers: Allow opening files from other apps -->
            <!-- Spreadsheet formats -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
                <data android:mimeType="application/vnd.ms-excel"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet"/>
            </intent-filter>
            
            <!-- Data formats -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/json"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="text/xml"/>
                <data android:mimeType="application/x-fadrec"/>
            </intent-filter>
            
            <!-- Document formats -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document"/>
                <data android:mimeType="application/msword"/>
                <!-- 한글 문서 -->
                <data android:mimeType="application/x-hwp"/>
                <data android:mimeType="application/haansofthwp"/>
                <data android:mimeType="application/vnd.hancom.hwp"/>
                <data android:mimeType="application/vnd.hancom.hwpx"/>
                <data android:mimeType="application/hwp"/>
                <data android:mimeType="application/x-hwp-v5"/>
                <data android:mimeType="application/hwp+zip"/>
                <data android:mimeType="application/x-hwpx"/>
                <data android:mimeType="application/haansofthwpx"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="application/rtf"/>
                <data android:mimeType="text/rtf"/>
                <data android:mimeType="application/vnd.oasis.opendocument.text"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="application/epub+zip"/>
                <data android:mimeType="application/vnd.oasis.opendocument.text-template"/>
            </intent-filter>
            
            <!-- Presentation formats -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/>
                <data android:mimeType="application/vnd.ms-powerpoint"/>
                <data android:mimeType="application/vnd.oasis.opendocument.presentation"/>
            </intent-filter>
            
            <!-- Code/text formats (including octet-stream for unrecognized MIME types) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/html"/>
                <data android:mimeType="text/markdown"/>
                <data android:mimeType="text/x-java"/>
                <data android:mimeType="text/x-python"/>
                <data android:mimeType="text/x-shellscript"/>
                <data android:mimeType="text/x-script.sh"/>
                <!-- Catch-all for file managers that return octet-stream for code/text files -->
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            
            <!-- Image formats (including ico, psd) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/png"/>
                <data android:mimeType="image/jpeg"/>
                <data android:mimeType="image/gif"/>
                <data android:mimeType="image/webp"/>
                <data android:mimeType="image/bmp"/>
                <data android:mimeType="image/svg+xml"/>
                <data android:mimeType="image/x-icon"/>
                <data android:mimeType="image/vnd.microsoft.icon"/>
                <data android:mimeType="image/vnd.adobe.photoshop"/>
            </intent-filter>

            <!-- Audio formats (all major types) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="audio/aac"/>
                <data android:mimeType="audio/mpeg"/>
                <data android:mimeType="audio/wav"/>
                <data android:mimeType="audio/x-wav"/>
                <data android:mimeType="audio/ogg"/>
                <data android:mimeType="audio/flac"/>
                <data android:mimeType="audio/x-m4a"/>
                <data android:mimeType="audio/x-ms-wma"/>
                <data android:mimeType="audio/opus"/>
                <data android:mimeType="audio/x-aiff"/>
            </intent-filter>

            <!-- Video formats (all major types) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/mp4"/>
                <data android:mimeType="video/x-msvideo"/>
                <data android:mimeType="video/x-matroska"/>
                <data android:mimeType="video/quicktime"/>
                <data android:mimeType="video/x-ms-wmv"/>
                <data android:mimeType="video/x-flv"/>
                <data android:mimeType="video/webm"/>
                <data android:mimeType="video/3gpp"/>
                <data android:mimeType="video/x-m4v"/>
                <data android:mimeType="video/mpeg"/>
            </intent-filter>

            <!-- XML-based feed formats -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/atom+xml"/>
                <data android:mimeType="application/rss+xml"/>
            </intent-filter>

            <!-- Catch-all for content:// URIs with null MIME types (e.g. .psd, .ico, .sh on some file managers).
                 This filter only matches content scheme. Kotlin code validates supported formats. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
            </intent-filter>

            <!-- File extension based handlers (fallback for unrecognized MIME types) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <!-- Spreadsheets -->
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.xlsx"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.xls"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.csv"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ods"/>
                <!-- Data formats -->
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.json"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.xml"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.fadrec"/>
                <!-- Documents -->
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.docx"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.doc"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.hwp"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.hwpx"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.pdf"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.rtf"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.txt"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.html"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.md"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.epub"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ott"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.log"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.java"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.py"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.sh"/>
                <!-- Presentations -->
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ppt"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.pptx"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.odp"/>
                <!-- Images -->
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.png"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.jpg"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.jpeg"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.gif"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.webp"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.bmp"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.svg"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ico"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.psd"/>
                <!-- Audio -->
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.aac"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mp3"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.wav"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ogg"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.flac"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.m4a"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.wma"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.opus"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.aiff"/>
                <!-- Video -->
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mp4"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.avi"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mkv"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mov"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.wmv"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.flv"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.webm"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.3gp"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.m4v"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mpg"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mpeg"/>
                <!-- Fragmented MP4 -->
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.fmp4"/>
                <!-- Feeds -->
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.atom"/>
            </intent-filter>
            <!-- [작동원리] 파일 관리자가 MIME 형식을 정확히 알려주지 않아도(octet-stream, 빈 값 등)
                 파일 이름의 확장자(.hwp .hwpx .doc(x) .ppt(x) .xls(x) .pdf)만 맞으면
                 '연결 프로그램' 목록에 이 앱이 나타나도록 하는 보강 필터. 경로에 점이 여러 개여도
                 매칭되도록 패턴을 3단계로 둔다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:mimeType="*/*"/>
                <data android:pathPattern=".*\\.hwp"/>
                <data android:pathPattern=".*\\..*\\.hwp"/>
                <data android:pathPattern=".*\\..*\\..*\\.hwp"/>
                <data android:pathPattern=".*\\.hwpx"/>
                <data android:pathPattern=".*\\..*\\.hwpx"/>
                <data android:pathPattern=".*\\..*\\..*\\.hwpx"/>
                <data android:pathPattern=".*\\.doc"/>
                <data android:pathPattern=".*\\..*\\.doc"/>
                <data android:pathPattern=".*\\..*\\..*\\.doc"/>
                <data android:pathPattern=".*\\.docx"/>
                <data android:pathPattern=".*\\..*\\.docx"/>
                <data android:pathPattern=".*\\..*\\..*\\.docx"/>
                <data android:pathPattern=".*\\.ppt"/>
                <data android:pathPattern=".*\\..*\\.ppt"/>
                <data android:pathPattern=".*\\..*\\..*\\.ppt"/>
                <data android:pathPattern=".*\\.pptx"/>
                <data android:pathPattern=".*\\..*\\.pptx"/>
                <data android:pathPattern=".*\\..*\\..*\\.pptx"/>
                <data android:pathPattern=".*\\.xls"/>
                <data android:pathPattern=".*\\..*\\.xls"/>
                <data android:pathPattern=".*\\..*\\..*\\.xls"/>
                <data android:pathPattern=".*\\.xlsx"/>
                <data android:pathPattern=".*\\..*\\.xlsx"/>
                <data android:pathPattern=".*\\..*\\..*\\.xlsx"/>
                <data android:pathPattern=".*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\..*\\.pdf"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:pathPattern=".*\\.hwp"/>
                <data android:pathPattern=".*\\..*\\.hwp"/>
                <data android:pathPattern=".*\\..*\\..*\\.hwp"/>
                <data android:pathPattern=".*\\.hwpx"/>
                <data android:pathPattern=".*\\..*\\.hwpx"/>
                <data android:pathPattern=".*\\..*\\..*\\.hwpx"/>
                <data android:pathPattern=".*\\.doc"/>
                <data android:pathPattern=".*\\..*\\.doc"/>
                <data android:pathPattern=".*\\..*\\..*\\.doc"/>
                <data android:pathPattern=".*\\.docx"/>
                <data android:pathPattern=".*\\..*\\.docx"/>
                <data android:pathPattern=".*\\..*\\..*\\.docx"/>
                <data android:pathPattern=".*\\.ppt"/>
                <data android:pathPattern=".*\\..*\\.ppt"/>
                <data android:pathPattern=".*\\..*\\..*\\.ppt"/>
                <data android:pathPattern=".*\\.pptx"/>
                <data android:pathPattern=".*\\..*\\.pptx"/>
                <data android:pathPattern=".*\\..*\\..*\\.pptx"/>
                <data android:pathPattern=".*\\.xls"/>
                <data android:pathPattern=".*\\..*\\.xls"/>
                <data android:pathPattern=".*\\..*\\..*\\.xls"/>
                <data android:pathPattern=".*\\.xlsx"/>
                <data android:pathPattern=".*\\..*\\.xlsx"/>
                <data android:pathPattern=".*\\..*\\..*\\.xlsx"/>
                <data android:pathPattern=".*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\.pdf"/>
                <data android:pathPattern=".*\\..*\\..*\\.pdf"/>
            </intent-filter>
            <!-- [작동원리] '공유' 메뉴(다운로드 알림, 카카오톡, 파일 관리자의 공유 등)에서
                 이 앱을 고를 수 있게 한다. MainActivity가 ACTION_SEND의 EXTRA_STREAM을 받아 열어 준다. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="application/x-hwp"/>
                <data android:mimeType="application/haansofthwp"/>
                <data android:mimeType="application/vnd.hancom.hwp"/>
                <data android:mimeType="application/vnd.hancom.hwpx"/>
                <data android:mimeType="application/hwp"/>
                <data android:mimeType="application/msword"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document"/>
                <data android:mimeType="application/vnd.ms-powerpoint"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/>
                <data android:mimeType="application/vnd.ms-excel"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
     <queries>
        <!-- 문서를 열어 준 앱(카카오톡 등)으로 돌아가기 위해 런처 앱 조회 허용 -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MANAGE_ALL_FILES_ACCESS_PERMISSION"/>
        </intent>
        <!-- Required by url_launcher for opening web URLs on Android 11+ -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
     </queries>
      <!-- Storage permissions for document scanning -->
      <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
      <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
      <uses-permission
          android:name="android.permission.WRITE_EXTERNAL_STORAGE"
          android:maxSdkVersion="29"
          tools:replace="android:maxSdkVersion"/>
      <!-- [보안] 이 앱은 인터넷/카메라가 필요 없다. 플러그인이 선언해도 병합 단계에서 제거한다.
           (인터넷 권한이 없으면 문서 내용이 밖으로 새거나 악성 코드가 내려받아질 수 없다.) -->
      <uses-permission android:name="android.permission.CAMERA" tools:node="remove"/>
      <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
      <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
      <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>
 </manifest>
